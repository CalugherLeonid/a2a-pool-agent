{
  "name": "a2a-pool-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-marketplace autonomous agent for the A2A pool ecosystem",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "db:ping": "tsx scripts/db-ping.ts"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}