# ──────────────────────────────────────────────────────────────────
#  a2a-pool-agent — Environment configuration
#
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env`. It is gitignored.
#  On production servers: chmod 600 .env
# ──────────────────────────────────────────────────────────────────

# ─── Agent Identity ────────────────────────────────────────────────
AGENT_ID=00000000-0000-0000-0000-000000000000
AGENT_NAME=agent-001
AGENT_ED25519_KEY_PATH=./keys/agent.key
AGENT_SOLANA_KEY_PATH=./keys/solana.key

# ─── Database (Neon Serverless Postgres) ──────────────────────────
# Get this from https://console.neon.tech → Project → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/a2a_learning?sslmode=require

# ─── LLM Providers ────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# DeepSeek (optional, paid): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ─── Adapters ─────────────────────────────────────────────────────
# Railway (your own a2a_pool platform)
RAILWAY_POOL_URL=https://a2a-pool-production.up.railway.app
RAILWAY_WORKER_ID=worker-railway-01

# OKX AI (V1: demo mode only)
OKX_AGENT_TASK_HOME=./okx-state
OKX_MODE=demo

# Clustly (V1: test mode)
CLUSTLY_API_KEY=

# ─── Economics ────────────────────────────────────────────────────
DAILY_BUDGET_USD=5.00
PER_TASK_BUDGET_USD=0.50
PER_TASK_HARD_FLOOR_USD=0.30
MIN_PROFIT_USD=0.05
MIN_SUCCESS_PROBABILITY=0.70
MIN_TIME_ADJUSTED_PROFIT=0.10

# ─── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
CORE_PORT=3000
GATEWAY_PORT=8000